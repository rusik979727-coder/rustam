# Дерекқор (dev: SQLite; prod: PostgreSQL — schema.prisma ішінде provider = "postgresql" қойыңыз)
DATABASE_URL="file:./dev.db"
# Сессия кілті (кез келген ұзын кездейсоқ жол)
AUTH_SECRET="change-me-to-a-long-random-string"

# ---- Автоматтандыру (міндетті емес: бос болса модуль өшірулі) ----
# Webhook және cron қорғанысы
WEBHOOK_SECRET=""
CRON_SECRET=""
# Telegram: бас менеджерге есеп пен эскалация
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# WhatsApp Business Cloud API (Meta)
WA_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_VERIFY_TOKEN=""
# Instagram (Meta Graph API) webhook верификациясы
IG_VERIFY_TOKEN=""
# SMS (Mobizon.kz) — WhatsApp жоқ болса қолданылады
MOBIZON_API_KEY=""
# Эскалация шегі (минут)
ESCALATION_MINUTES="15"
