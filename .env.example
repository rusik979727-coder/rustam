# Дерекқор (dev: SQLite; prod: PostgreSQL — schema.prisma ішінде provider = "postgresql" қойыңыз)
DATABASE_URL="file:./dev.db"
# Сессия кілті — МІНДЕТТІ, кемінде 32 таңба. Жасау: openssl rand -base64 48
# Продакшнда бос/қысқа болса жүйе іске қосылмайды.
AUTH_SECRET=""

# ---- Автоматтандыру (міндетті емес: бос болса модуль өшірулі) ----
# Webhook және cron қорғанысы
WEBHOOK_SECRET=""
CRON_SECRET=""
# Telegram: бас менеджерге есеп пен эскалация
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# WhatsApp Business Cloud API (Meta)
WA_TOKEN=""
WA_PHONE_NUMBER_ID=""
WA_VERIFY_TOKEN=""
# Meta App Secret — WhatsApp/Instagram webhook қолтаңбасын тексеру үшін (онсыз webhook-тер қабылданбайды)
META_APP_SECRET=""
# Еске салу: қабылдаудан неше сағат бұрын (тегін терезе ашық болса — тегін; жабық болса және
# пациент растамаса — бір ақылы үлгі хабарлама)
REMINDER_HOURS="24"
# Meta-да бекітілген үлгі (template) атаулары және тілі
# appointment_reminder мәтіні: {{1}} — аты, {{2}} — конс күні/уақыты
WA_TPL_REMINDER="appointment_reminder"
# client_followup мәтіні: {{1}} — аты
WA_TPL_FOLLOWUP="client_followup"
WA_TPL_LANG="kk"
# Instagram (Meta Graph API) webhook верификациясы
IG_VERIFY_TOKEN=""
# SMS (Mobizon.kz) — WhatsApp жоқ болса қолданылады
MOBIZON_API_KEY=""
# Эскалация шегі (минут)
ESCALATION_MINUTES="15"
