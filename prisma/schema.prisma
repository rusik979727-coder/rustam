// Белес — менеджерлерге арналған өтінімдер (лидтер) жүйесі
// Статустар мен түрлер String түрінде сақталады (мәндері lib/constants.ts ішінде).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int            @id @default(autoincrement())
  name           String
  login          String         @unique
  passwordHash   String
  role           String // HEAD_MANAGER | MANAGER
  active         Boolean        @default(true)
  lastAssignedAt DateTime?
  sessionVersion Int            @default(0) // құпиясөз ауысса/өшірілсе — ескі сессиялар жарамсыз
  createdAt      DateTime       @default(now())
  leads          Lead[]
  tasks          Task[]
  activities     LeadActivity[]
  plans          MonthlyPlan[]
  auditLogs      AuditLog[]
  messages       Message[]
}

model Lead {
  id                 Int            @id @default(autoincrement())
  name               String
  phone              String
  source             String
  complaint          String         @default("OTHER")
  // NEW=Лид, CONTACTED=Обработка, NO_ANSWER=Не отвечает, BOOKED=Конс, ARRIVED=Келді,
  // PAID=Емге төледі, LOST=Отказ, SPAM=Басылып кетті
  status             String         @default("NEW")
  comment            String?
  lostReason         String?
  nextContactAt      DateTime?
  firstResponseAt    DateTime?
  escalatedAt        DateTime?
  // Консультация (кестенің орнына — тек күні мен уақыты)
  consultAt          DateTime?
  consultConfirmedAt DateTime? // клиент WhatsApp-та «1» деп растады
  remindMainSent     Boolean        @default(false)
  remindSameDaySent  Boolean        @default(false)
  // Емге төлегенде — сома (түсім есебі үшін)
  amount             Int?
  paidAt             DateTime?
  managerId          Int?
  manager            User?          @relation(fields: [managerId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  activities         LeadActivity[]
  tasks              Task[]
  messages           Message[]

  @@index([status])
  @@index([managerId])
  @@index([phone])
  @@index([consultAt])
}

model LeadActivity {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // CALL MESSAGE NOTE STATUS SYSTEM
  text      String
  createdAt DateTime @default(now())
}

model Task {
  id         Int      @id @default(autoincrement())
  title      String
  kind       String   @default("MANUAL") // MANUAL CALLBACK RESCHEDULE ESCALATION
  assigneeId Int
  assignee   User     @relation(fields: [assigneeId], references: [id])
  leadId     Int?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  refKey     String?  @unique // автотапсырма қайталанбауы үшін
  dueAt      DateTime
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([assigneeId, done])
}

model MonthlyPlan {
  id        Int    @id @default(autoincrement())
  month     String // "2026-11"
  managerId Int?
  manager   User?  @relation(fields: [managerId], references: [id])
  leads     Int    @default(0)
  bookings  Int    @default(0) // конс саны
  revenue   Int    @default(0)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  Int?
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Логин әрекеттері (құпиясөзді таңдаудан қорғау)
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  key       String // login + IP
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// WhatsApp хабарламалары (кіріс және шығыс)
model Message {
  id        Int       @id @default(autoincrement())
  phone     String // +7XXXXXXXXXX
  direction String // IN | OUT
  kind      String    @default("TEXT") // TEXT | TEMPLATE
  text      String
  // OUT: queued | sent | delivered | read | failed | offline (WhatsApp қосылмаған)
  status    String    @default("sent")
  paid      Boolean   @default(false)
  waId      String?   @unique
  error     String?
  userId    Int?
  user      User?     @relation(fields: [userId], references: [id])
  leadId    Int?
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([direction, readAt])
}
